<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Fond}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Marine}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource GrisClair}" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style TargetType="Editor">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Marine}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource GrisClair}" />
    </Style>

    <Style x:Key="Titre" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Marine}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="SousTitre" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Marine}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="Legende" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Gris}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="LabelChamp" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Gris}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Carte" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Carte}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="ChampBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Champ}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>
    <Style x:Key="Puce" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Champ}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style x:Key="BoutonPrincipal" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="56" />
    </Style>
    <Style x:Key="BoutonSecondaire" TargetType="Button">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource Marine}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="56" />
    </Style>
</ResourceDictionary>
