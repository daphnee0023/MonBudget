<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonBudget.Views.Components.EnteteApp"
             x:Name="racine">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14" Padding="20,14">
        <VerticalStackLayout>
            <Label Text="MONBUDGET" FontSize="12" FontAttributes="Bold"
                   TextColor="{StaticResource Indigo}" CharacterSpacing="1" />
            <Label Text="{Binding Titre, Source={x:Reference racine}}"
                   Style="{StaticResource SousTitre}" FontSize="22" />
        </VerticalStackLayout>
        <Image Source="ic_bell_marine.png" WidthRequest="24" HeightRequest="24" Grid.Column="1" VerticalOptions="Center" />
        <Border Grid.Column="2" WidthRequest="44" HeightRequest="44"
                BackgroundColor="{StaticResource Marine}" StrokeShape="RoundRectangle 22" Stroke="Transparent">
            <Image Source="ic_user_blanc.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnProfilTapped" />
            </Border.GestureRecognizers>
        </Border>
    </Grid>
</ContentView>
