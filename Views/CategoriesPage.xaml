<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:MonBudget.Views.Components"
             x:Class="MonBudget.Views.CategoriesPage">
    <Grid RowDefinitions="Auto,*">
        <comp:EnteteApp Titre="Dépenses" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,28" Spacing="18">
                <Label Text="Catégories" Style="{StaticResource Titre}" FontSize="24" HorizontalOptions="Center" />

                <Border Background="{StaticResource DegradeBleu}" Stroke="Transparent"
                        StrokeShape="RoundRectangle 18" Padding="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="GESTION BUDGÉTAIRE" TextColor="#AEB8F5" FontSize="12" CharacterSpacing="1" />
                            <Label x:Name="LabelNbCategories" Text="0 Catégories actives" TextColor="White"
                                   FontSize="22" FontAttributes="Bold" />
                            <Label x:Name="LabelTotalMois" Text="" TextColor="{StaticResource CyanClair}" FontSize="14" />
                        </VerticalStackLayout>
                        <Image Grid.Column="1" Source="ic_sliders_blanc.png" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout x:Name="ListeCategories" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14" Padding="0,14">
                                        <Border WidthRequest="52" HeightRequest="52" BackgroundColor="{Binding CouleurDouce}"
                                                Stroke="Transparent" StrokeShape="RoundRectangle 26">
                                            <Image Source="{Binding IconeImage}" WidthRequest="26" HeightRequest="26"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Nom}" Style="{StaticResource SousTitre}" FontSize="18" />
                                            <Label Text="{Binding Description}" Style="{StaticResource Legende}" FontSize="13" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                            <Label Text="{Binding MontantTexte}" Style="{StaticResource SousTitre}" FontSize="14"
                                                   HorizontalTextAlignment="End" />
                                            <Label Text="{Binding ResumeTexte}" Style="{StaticResource Legende}" FontSize="11"
                                                   HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                        <Image Grid.Column="3" Source="ic_chevron_right_gris.png" WidthRequest="20" HeightRequest="20"
                                               VerticalOptions="Center" />
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCategorieTapped" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="{StaticResource FondDoux}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource Champ}" Stroke="Transparent"
                        StrokeShape="RoundRectangle 14" Padding="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_bulb_indigo.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Start" />
                        <Label Grid.Column="1" Text="Touchez une catégorie pour voir ses dépenses. Les montants affichés sont ceux du mois en cours."
                               Style="{StaticResource Legende}" FontSize="13" />
                    </Grid>
                </Border>

                <Button Text="Voir toutes les dépenses" Style="{StaticResource BoutonSecondaire}"
                        Clicked="OnToutesDepensesClicked" />
                <Button Text="+ Nouvelle catégorie" Style="{StaticResource BoutonPrincipal}"
                        Clicked="OnNouvelleCategorieClicked" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
