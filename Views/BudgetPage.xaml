<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:MonBudget.Views.Components"
             x:Class="MonBudget.Views.BudgetPage">
    <Grid RowDefinitions="Auto,*">
        <comp:EnteteApp Titre="Budget Paramètres" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,28" Spacing="18">

                <Border Style="{StaticResource Puce}" BackgroundColor="White" HorizontalOptions="Start">
                    <HorizontalStackLayout Spacing="8"><Image Source="ic_calendar_indigo.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" /><Label TextColor="{StaticResource Gris}" VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Mois en cours : " />
                                <Span Text="Octobre 2026" TextColor="{StaticResource Marine}" FontAttributes="Bold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label></HorizontalStackLayout>
                </Border>

                <Border Background="{StaticResource DegradeBleu}" Stroke="Transparent"
                        StrokeShape="RoundRectangle 22" Padding="22">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="8"><Image Source="ic_target_blanc.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" /><Label Text="OBJECTIF DE DÉPENSE" TextColor="#CCD6FF" FontSize="13" CharacterSpacing="1" VerticalOptions="Center" /></HorizontalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#33FFFFFF" Stroke="Transparent"
                                    StrokeShape="RoundRectangle 12" Padding="10,3">
                                <Label Text="Actif" TextColor="White" FontSize="12" />
                            </Border>
                        </Grid>
                        <Label Text="Plafond fixé" TextColor="#CCD6FF" FontSize="14" Margin="0,16,0,0" />
                        <HorizontalStackLayout Spacing="6">
                            <Label x:Name="LabelPlafond" Text="150 000" TextColor="White" FontSize="40" FontAttributes="Bold" />
                            <Label Text="FCFA" TextColor="{StaticResource CyanClair}" FontSize="22"
                                   VerticalOptions="End" Margin="0,0,0,6" />
                        </HorizontalStackLayout>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Seuil d'alerte (80%)" TextColor="#CCD6FF" FontSize="13" />
                            <Label x:Name="LabelSeuil" Grid.Column="1" Text="120 000 FCFA" TextColor="White"
                                   FontAttributes="Bold" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Budget maximum" Style="{StaticResource LabelChamp}" TextColor="Black" />
                        <Label Grid.Column="1" Text="FCFA (XOF)" TextColor="{StaticResource Indigo}" FontSize="13" />
                    </Grid>
                    <Border Style="{StaticResource Carte}" Padding="18,6">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Image Source="ic_wallet_indigo.png" WidthRequest="28" HeightRequest="28" VerticalOptions="Center" />
                            <Entry x:Name="EntryBudget" Grid.Column="1" Text="150000" Keyboard="Numeric"
                                   FontSize="30" FontAttributes="Bold" TextChanged="OnBudgetChanged" />
                            <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center"><Label Text="FCFA" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Gris}" VerticalOptions="Center" /><Image Source="ic_edit_gris.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" /></HorizontalStackLayout>
                        </Grid>
                    </Border>
                    <Label Text="Dépense maximale autorisée pour les 31 jours d'octobre."
                           Style="{StaticResource Legende}" Margin="0,6,0,0" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Image Source="ic_bell_indigo.png" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="M'alerter à 80% du budget ?" Style="{StaticResource SousTitre}" TextColor="Black" />
                                <Label Text="Recommandé pour prévenir les dépassements" Style="{StaticResource Legende}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border BackgroundColor="{StaticResource FondDoux}" Stroke="Transparent"
                                    StrokeShape="RoundRectangle 14" Padding="10,8">
                                <RadioButton x:Name="RadioOui" GroupName="Alerte" IsChecked="True"
                                             Content="Oui · à 120 000 FCFA" FontSize="13" />
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource FondDoux}" Stroke="Transparent"
                                    StrokeShape="RoundRectangle 14" Padding="10,8">
                                <RadioButton x:Name="RadioNon" GroupName="Alerte" Content="Non · désactivé" FontSize="13" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Carte}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#E3F4FC" Stroke="Transparent"
                                StrokeShape="RoundRectangle 24">
                            <Image Source="ic_bulb_cyan.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Conseil MonBudget" Style="{StaticResource SousTitre}" FontSize="14" />
                            <Label Text="Une alerte vous sera envoyée lorsque vous atteindrez 80% de votre budget mensuel."
                                   FontSize="15" TextColor="{StaticResource Gris}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Rythme prévisionnel journalier" Style="{StaticResource Legende}" FontSize="14" />
                            <Label x:Name="LabelRythme" Grid.Column="1" Text="~ 4 838 FCFA / jour"
                                   TextColor="{StaticResource Marine}" FontAttributes="Bold" />
                        </Grid>
                        <ProgressBar Progress="0.8" ProgressColor="{StaticResource Indigo}" />
                        <Grid ColumnDefinitions="*,*,*">
                            <Label Text="0 FCFA" Style="{StaticResource Legende}" />
                            <Label x:Name="LabelSeuilBarre" Grid.Column="1" Text="80% (120 000 FCFA)"
                                   TextColor="{StaticResource Indigo}" FontSize="12" HorizontalOptions="Center" />
                            <Label x:Name="LabelMax" Grid.Column="2" Text="150 000 FCFA" Style="{StaticResource Legende}"
                                   HorizontalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button Text="✓  Enregistrer" Style="{StaticResource BoutonPrincipal}"
                        BackgroundColor="{StaticResource Marine}" Clicked="OnEnregistrerClicked" />
                <Label Text="Modifiable à tout moment depuis l'onglet Budget." Style="{StaticResource Legende}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
