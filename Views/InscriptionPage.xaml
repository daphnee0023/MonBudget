<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonBudget.Views.InscriptionPage">
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*" Padding="20,14" ColumnSpacing="16">
            <Button Text="←" FontSize="24" BackgroundColor="Transparent" TextColor="{StaticResource Marine}"
                    Padding="0" WidthRequest="40" Clicked="OnRetourClicked" />
            <Label Grid.Column="1" Text="Inscription" Style="{StaticResource SousTitre}" FontSize="22"
                   VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,28" Spacing="18">
                <Label Text="Créer un compte" Style="{StaticResource Titre}" FontSize="32" />

                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="14">

                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Nom et Prénom" Style="{StaticResource LabelChamp}" />
                                <Label Grid.Column="1" Text="Requis" Style="{StaticResource Legende}" />
                            </Grid>
                            <Border Style="{StaticResource ChampBorder}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Image Source="ic_user_gris" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                    <Entry x:Name="EntryNom" Grid.Column="1" Placeholder="Ex : Amadou Diallo" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Numéro de téléphone / Email" Style="{StaticResource LabelChamp}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Style="{StaticResource ChampBorder}" WidthRequest="90">
                                    <Label Text="+237 ⌄" FontAttributes="Bold" TextColor="{StaticResource Marine}"
                                           VerticalOptions="Center" HorizontalOptions="Center" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource ChampBorder}">
                                    <Entry x:Name="EntryContact" Placeholder="6XXXXXXXX ou e-mail" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Devise principale du compte" Style="{StaticResource LabelChamp}" />
                            <Border Style="{StaticResource ChampBorder}" HeightRequest="64">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource Marine}"
                                            StrokeShape="RoundRectangle 20" Stroke="Transparent" VerticalOptions="Center">
                                        <Label Text="F" TextColor="White" FontAttributes="Bold"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="FCFA (XOF/XAF)" FontAttributes="Bold" />
                                        <Label Text="Afrique de l'Ouest &amp; Centrale" Style="{StaticResource Legende}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" Style="{StaticResource Puce}" BackgroundColor="#CDEBFB"
                                            Padding="10,4" VerticalOptions="Center">
                                        <Label Text="Actif" FontSize="12" FontAttributes="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Mot de passe sécurisé" Style="{StaticResource LabelChamp}" />
                            <Border Style="{StaticResource ChampBorder}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Image Source="ic_lock_gris" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                    <Entry x:Name="EntryMotDePasse" Grid.Column="1" IsPassword="True" TextChanged="OnMotDePasseChanged" />
                                    <Image x:Name="IconeOeil" Grid.Column="2" Source="ic_eye_gris" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnAfficherMotDePasseTapped" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </Grid>
                            </Border>
                            <Border BackgroundColor="{StaticResource FondDoux}" Stroke="Transparent"
                                    StrokeShape="RoundRectangle 14" Padding="14" Margin="0,10,0,0">
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="8"><Image x:Name="IconeLongueur" Source="ic_circle_gris" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" /><Label x:Name="RegleLongueur" Text="Au moins 8 caractères" TextColor="{StaticResource Gris}" FontSize="14" VerticalOptions="Center" /></HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="8"><Image x:Name="IconeChiffre" Source="ic_circle_gris" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" /><Label x:Name="RegleChiffre" Text="Au moins un chiffre ou symbole" TextColor="{StaticResource Gris}" FontSize="14" VerticalOptions="Center" /></HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="8"><Image x:Name="IconeMajuscule" Source="ic_circle_gris" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" /><Label x:Name="RegleMajuscule" Text="Une lettre majuscule" TextColor="{StaticResource Gris}" FontSize="14" VerticalOptions="Center" /></HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Confirmer le mot de passe" Style="{StaticResource LabelChamp}" />
                                <Label x:Name="LabelCorrespondance" Grid.Column="1" Text="" IsVisible="False"
                                       TextColor="{StaticResource Succes}" FontSize="11" />
                            </Grid>
                            <Border Style="{StaticResource ChampBorder}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Image Source="ic_lock_gris" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                    <Entry x:Name="EntryConfirmation" Grid.Column="1" IsPassword="True" TextChanged="OnConfirmationChanged" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="CheckCGU" Color="{StaticResource Primary}" />
                            <Label VerticalOptions="Center" FontSize="14" LineBreakMode="WordWrap" WidthRequest="260">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="J'accepte les " />
                                        <Span Text="Conditions Générales" TextColor="{StaticResource Indigo}"
                                              TextDecorations="Underline" FontAttributes="Bold" />
                                        <Span Text=" et la " />
                                        <Span Text="Politique de confidentialité" TextColor="{StaticResource Indigo}"
                                              TextDecorations="Underline" FontAttributes="Bold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Créer mon compte  →" Style="{StaticResource BoutonPrincipal}" Clicked="OnCreerCompteClicked" />

                <Label HorizontalOptions="Center" FontSize="15">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Vous avez déjà un compte ? " TextColor="{StaticResource Gris}" />
                            <Span Text="Se connecter" TextColor="{StaticResource Indigo}" FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSeConnecterTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
