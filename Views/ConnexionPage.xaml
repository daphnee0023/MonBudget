<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonBudget.Views.ConnexionPage">
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*" Padding="20,14" ColumnSpacing="16">
            <Button Text="←" FontSize="24" BackgroundColor="Transparent" TextColor="{StaticResource Marine}"
                    Padding="0" WidthRequest="40" Clicked="OnRetourClicked" />
            <Label Grid.Column="1" Text="Connexion" Style="{StaticResource SousTitre}" FontSize="22"
                   VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,24" Spacing="18">

                <Border Background="{StaticResource DegradeBleu}" Stroke="Transparent"
                        StrokeShape="RoundRectangle 22" Padding="22">
                    <VerticalStackLayout Spacing="10">
                        <Border BackgroundColor="#33FFFFFF" Stroke="Transparent" StrokeShape="RoundRectangle 14"
                                Padding="10,4" HorizontalOptions="Start">
                            <Label Text="MONBUDGET • FCFA" TextColor="{StaticResource CyanClair}"
                                   FontSize="12" FontAttributes="Bold" />
                        </Border>
                        <Label Text="Bon retour" TextColor="White" FontSize="32" FontAttributes="Bold" />
                        <Label Text="Connectez-vous pour piloter vos dépenses, épargnes et budgets en temps réel."
                               TextColor="#CCD6FF" FontSize="15" />
                        <Border BackgroundColor="#22FFFFFF" Stroke="Transparent" StrokeShape="RoundRectangle 12"
                                Padding="10,6" HorizontalOptions="Start">
                            <HorizontalStackLayout Spacing="6"><Image Source="ic_shield_blanc" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" /><Label Text="Session sécurisée par chiffrement bancaire" TextColor="White" FontSize="12" VerticalOptions="Center" /></HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout>
                            <Label Text="Téléphone ou E-mail" Style="{StaticResource LabelChamp}" />
                            <Border Style="{StaticResource ChampBorder}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Image Source="ic_at_gris" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                    <Entry x:Name="EntryIdentifiant" Grid.Column="1" Placeholder="ex : 6XXXXXXXX ou nom@mail.com" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Mot de passe" Style="{StaticResource LabelChamp}" />
                            <Border Style="{StaticResource ChampBorder}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Image Source="ic_lock_gris" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                    <Entry x:Name="EntryMotDePasse" Grid.Column="1" IsPassword="True" Placeholder="••••••••" />
                                    <Image x:Name="IconeOeil" Grid.Column="2" Source="ic_eye_gris" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnAfficherMotDePasseTapped" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="6">
                                <CheckBox Color="{StaticResource Primary}" />
                                <Label Text="Se souvenir de moi" VerticalOptions="Center" FontSize="14" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="Mot de passe oublié ?" FontAttributes="Bold"
                                   TextColor="{StaticResource Indigo}" FontSize="14" VerticalOptions="Center" />
                        </Grid>

                        <Button Text="Se connecter  →" Style="{StaticResource BoutonPrincipal}" Clicked="OnConnexionClicked" />

                        <Label Text="OU CONTINUER AVEC" Style="{StaticResource Legende}"
                               HorizontalOptions="Center" CharacterSpacing="1" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Text="Apple" ImageSource="ic_apple" ContentLayout="Left,10" BackgroundColor="{StaticResource Champ}" TextColor="Black" CornerRadius="14" HeightRequest="52" />
                            <Button Grid.Column="1" Text="Google" ImageSource="ic_google" ContentLayout="Left,10" BackgroundColor="{StaticResource Champ}" TextColor="Black" CornerRadius="14" HeightRequest="52" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Carte}" BackgroundColor="{StaticResource Champ}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout>
                            <Label Text="Nouveau sur MonBudget ?" FontSize="16" />
                            <Label Text="Rejoignez 45 000+ épargnants en FCFA" Style="{StaticResource Legende}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Créer un compte" Style="{StaticResource BoutonSecondaire}"
                                HeightRequest="48" Padding="16,0" Clicked="OnCreerCompteClicked" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
