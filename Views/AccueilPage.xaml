<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:MonBudget.Views.Components"
             x:Class="MonBudget.Views.AccueilPage">
    <Grid RowDefinitions="Auto,*">
        <comp:EnteteApp Titre="Accueil" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,110" Spacing="18">
                <VerticalStackLayout>
                    <Label x:Name="LabelBonjour" Text="Bonjour" Style="{StaticResource Titre}" FontSize="32" />
                    <Label Text="Octobre 2026" Style="{StaticResource Legende}" FontSize="14" />
                </VerticalStackLayout>

                <!-- Carte budget mensuel -->
                <Border Background="{StaticResource DegradeBleu}" Stroke="Transparent"
                        StrokeShape="RoundRectangle 24" Padding="22">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="BUDGET MENSUEL" TextColor="#CCD6FF" FontSize="13" CharacterSpacing="1" />
                            <Border Grid.Column="1" BackgroundColor="#33FFFFFF" Stroke="Transparent"
                                    StrokeShape="RoundRectangle 12" Padding="10,3">
                                <Label Text="● En cours" TextColor="White" FontSize="12" />
                            </Border>
                        </Grid>
                        <HorizontalStackLayout Spacing="6">
                            <Label x:Name="LabelBudget" Text="150 000" TextColor="White" FontSize="40" FontAttributes="Bold" />
                            <Label Text="FCFA" TextColor="#CCD6FF" FontSize="20" VerticalOptions="End" Margin="0,0,0,6" />
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="1" Color="#44FFFFFF" />
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Dépensé" TextColor="#CCD6FF" FontSize="14" />
                                <Label x:Name="LabelDepense" Text="85 000 FCFA" TextColor="White" FontSize="22" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                <Label Text="Restant" TextColor="{StaticResource CyanClair}" FontSize="14" HorizontalOptions="End" />
                                <Label x:Name="LabelRestant" Text="65 000 FCFA" TextColor="{StaticResource CyanClair}" FontSize="22" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                        <ProgressBar x:Name="BarreBudget" Progress="0.57" ProgressColor="{StaticResource CyanClair}" BackgroundColor="#44FFFFFF" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="LabelAlloue" Text="57% alloué" TextColor="#CCD6FF" FontSize="13" />
                            <Label x:Name="LabelMarge" Grid.Column="1" Text="43% marge" TextColor="White" FontSize="13" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Rythme -->
                <Border Style="{StaticResource Carte}" BackgroundColor="{StaticResource FondDoux}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#E3F1E4" Stroke="Transparent"
                                StrokeShape="RoundRectangle 24">
                            <Image Source="ic_trend_down_vert" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Rythme sain" Style="{StaticResource SousTitre}" />
                            <Label Text="Sous la moyenne d'Octobre" Style="{StaticResource Legende}" FontSize="14" />
                        </VerticalStackLayout>
                        <Image Source="ic_trend_up_vert" WidthRequest="36" HeightRequest="36" Grid.Column="2" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Dernières dépenses -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Dernières dépenses" Style="{StaticResource Titre}" FontSize="22" />
                    <Label Grid.Column="1" Text="Voir tout ›" TextColor="{StaticResource Indigo}"
                           FontAttributes="Bold" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVoirToutTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout x:Name="ListeDepenses" Spacing="20">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border WidthRequest="52" HeightRequest="52" BackgroundColor="{StaticResource FondDoux}"
                                            Stroke="Transparent" StrokeShape="RoundRectangle 26">
                                        <Image Source="{Binding Icone}" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Categorie}" Style="{StaticResource SousTitre}" />
                                        <Label Text="{Binding DateTexte}" Style="{StaticResource Legende}" FontSize="14" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                        <Label Text="{Binding MontantTexte}" Style="{StaticResource SousTitre}"
                                               HorizontalTextAlignment="End" />
                                        <Label Text="{Binding Note}" Style="{StaticResource Legende}"
                                               HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bouton flottant + -->
        <Button Grid.Row="1" Text="+" FontSize="32" TextColor="White" BackgroundColor="{StaticResource Primary}"
                WidthRequest="64" HeightRequest="64" CornerRadius="32" Padding="0"
                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,24,24"
                Clicked="OnAjouterClicked" />
    </Grid>
</ContentPage>
